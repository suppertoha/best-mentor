{
  "name": "best-mentor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "optimize:svg": "svgo src/shared/assets/icons/*.svg src/shared/assets/images/*.svg --config svgo.config.cjs --multipass",
    "optimize:images": "node scripts/optimize-images.mjs",
    "seed": "node scripts/seed-chapters.mjs",
    "seed:html": "node scripts/seed-chapters.mjs html",
    "seed:css": "node scripts/seed-chapters.mjs css",
    "seed:javascript": "node scripts/seed-chapters.mjs javascript",
    "seed:react": "node scripts/ensure-section.mjs react && node scripts/seed-chapters.mjs react",
    "quizzes:build": "node scripts/build-quizzes-json.mjs",
    "seed:quizzes": "node scripts/seed-quizzes.mjs",
    "seed:quizzes:html": "node scripts/seed-quizzes.mjs html",
    "seed:quizzes:css": "node scripts/seed-quizzes.mjs css",
    "seed:quizzes:javascript": "node scripts/seed-quizzes.mjs javascript",
    "seed:quizzes:react": "node scripts/seed-quizzes.mjs react",
    "seed:quizzes:all": "npm run quizzes:build && npm run seed:quizzes:html && npm run seed:quizzes:css && npm run seed:quizzes:javascript && npm run seed:quizzes:react",
    "seed:cleanup": "node scripts/cleanup-chapters.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "seed:all": "npm run seed:cleanup && npm run seed:html && npm run seed:css && npm run seed:javascript && npm run seed:react"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.7.1",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-query": "5.104.2",
    "@uiw/react-md-editor": "4.1.1",
    "axios": "1.18.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dompurify": "3.4.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.83.0",
    "react-markdown": "10.1.0",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.1",
    "rehype-prism-plus": "2.0.2",
    "remark-gfm": "4.0.1",
    "sass": "1.102.0",
    "sonner": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "5.104.2",
    "@types/dompurify": "3.0.5",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "globals": "17.7.0",
    "sharp": "0.34.3",
    "svgo": "3.3.2",
    "typescript": "~6.0.2",
    "vite": "8.1.1",
    "vite-plugin-svgr": "5.2.0"
  }
}
